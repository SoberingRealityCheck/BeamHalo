# Vivado generated folders. Vivado rebuilds all of these.
# We keep the .xpr and the .srcs folder (sources, .xci, constraints).
fpga/*/*.cache/
fpga/*/*.gen/
fpga/*/*.hw/
fpga/*/*.ip_user_files/
fpga/*/*.runs/
fpga/*/*.sim/
.Xil/

# Vivado logs, journals, dumps
*.jou
*.log
*.str
*.backup.jou
*.backup.log
hs_err_pid*
webtalk*

# Waveforms + ILA captures. Export CSVs to data/ if you want to keep one.
*.wdb
*.ila
*.ltx

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# mac
.DS_Store

# stale incremental synth checkpoint (Vivado remakes it)
fpga/*/*.srcs/utils_1/

# verilator build + run output
verilator/obj/
verilator/run/
verilator/build.log

# cpp_check build output
cpp_check/build/

# regenerated by python/make_sweeps.py (about 600 KB)
fpga/sim_data/hit_data_sweep.txt

# vivado checkpoints and logs from fpga/tcl/synth_tagger.tcl
fpga/build/
